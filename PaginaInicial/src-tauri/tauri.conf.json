{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sanctuary",
  "version": "1.0.1",
  "identifier": "com.sanctuary.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000/MenuPrincipal.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SANCTUARY",
        "url": "MenuPrincipal.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
