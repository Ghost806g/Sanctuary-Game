{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:sonarjs/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "html",
    "sonarjs"
  ],
  "globals": {
    "__TAURI__": "readonly"
  },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "warn",
    "sonarjs/no-duplicate-string": "warn",
    "sonarjs/cognitive-complexity": "warn",
    "no-empty": "warn",
    "no-constant-condition": "warn"
  }
}
